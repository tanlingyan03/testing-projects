                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-008 发布商品",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{user_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/user/product",
              "host": ["{{base_url}}"],
              "path": ["user", "product"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"测试商品_{{$timestamp}}\",\n  \"description\": \"这是一个接口测试发布的商品\",\n  \"price\": 99.99,\n  \"originalPrice\": 199.99,\n  \"categoryId\": {{category_id}},\n  \"images\": [\"https://example.com/test.jpg\"],\n  \"condition\": \"九成新\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('发布成功code应为0', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.code).to.eql(0);",
                  "});",
                  "",
                  "pm.test('响应应包含商品ID', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data).to.have.property('id');",
                  "});",
                  "",
                  "// 保存发布的商品ID",
