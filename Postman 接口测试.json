    {
      "name": "02-商品模块",
      "item": [
        {
          "name": "TC-005 获取商品列表",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/user/products?page=1&size=10",
              "host": ["{{base_url}}"],
              "path": ["user", "products"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "size", "value": "10"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('响应应为数组或分页对象', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data).to.be.an('object');",
                  "  pm.expect(jsonData.data).to.have.property('list');",
                  "});",
                  "",
                  "pm.test('商品列表项应包含必要字段', function() {",
                  "  var jsonData = pm.response.json();",
                  "  if (jsonData.data.list && jsonData.data.list.length > 0) {",
                  "    var item = jsonData.data.list[0];",
                  "    pm.expect(item).to.have.property('id');",
                  "    pm.expect(item).to.have.property('title');",
                  "    pm.expect(item).to.have.property('price');",
                  "  }",
                  "});",
                  "",
                  "// 保存第一个商品ID",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data.list && jsonData.data.list.length > 0) {",
                  "  pm.environment.set('product_id', jsonData.data.list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
