{
  "info": {
    "_postman_id": "campus-trade-api-test-2024",
    "name": "CampusTrade API 接口测试",
    "description": "校园二手交易平台API接口测试集合，覆盖用户注册、商品发布、订单创建等20个核心接口，包含状态码校验、响应结构断言及业务逻辑验证。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01-用户认证",
      "item": [
        {
          "name": "TC-001 用户注册",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/user/register",
              "host": ["{{base_url}}"],
              "path": ["user", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_{{$timestamp}}\",\n  \"password\": \"test123456\",\n  \"confirmPassword\": \"test123456\",\n  \"phone\": \"13800138000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 状态码校验",
                  "pm.test('状态码应为200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 响应结构校验",
                  "pm.test('响应应包含code和data字段', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.have.property('code');",
                  "  pm.expect(jsonData).to.have.property('data');",
                  "});",
                  "",
                  "// 业务逻辑校验",
                  "pm.test('注册成功code应为0', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.code).to.eql(0);",
                  "});",
                  "",
                  "// 保存注册用户名供后续使用",
                  "var reqBody = JSON.parse(pm.request.body.raw);",
                  "pm.environment.set('registered_username', reqBody.username);",
                  "pm.environment.set('registered_password', reqBody.password);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-002 用户登录",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{base_url}}/user/login",
              "host": ["{{base_url}}"],
              "path": ["user", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{registered_username}}\",\n  \"password\": \"{{registered_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('响应应包含token', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data).to.have.property('token');",
                  "  pm.expect(jsonData.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('登录成功code应为0', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.code).to.eql(0);",
                  "});",
                  "",
                  "// 保存token",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('user_token', jsonData.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "TC-003 获取用户信息",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{user_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/user/info",
              "host": ["{{base_url}}"],
              "path": ["user", "info"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('响应应包含用户基本信息', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data).to.have.property('username');",
                  "  pm.expect(jsonData.data).to.have.property('phone');",
                  "});",
                  "",
                  "pm.test('用户名应与注册时一致', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data.username).to.eql(pm.environment.get('registered_username'));",
                  "});",
                  "",
                  "pm.test('code应为0', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.code).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
